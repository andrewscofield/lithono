# Copy to .env locally. Do not commit real credentials.
# Node >=22.13; server configuration loads .env without overriding exported settings.
LITHONO_DEMO_DATABASE=.data/app.sqlite
BETTER_AUTH_URL=http://localhost:5173
# Generate a unique secret (e.g. openssl rand -hex 32).
BETTER_AUTH_SECRET=
# Editorial access: explicitly provisioned account IDs, or VERIFIED emails.
# Signup's unverified email claim never grants this role. Empty lists deny editors.
LITHONO_EDITOR_USER_IDS=
LITHONO_EDITOR_EMAILS=

# Resend verified sender; both settings required for email acceptance.
RESEND_API_KEY=
RESEND_FROM=

# Property map: public MapLibre style URL, includes configured tile sources.
# No default provider/key. SDK, CSS, workers and style load only in map view.
LITHONO_MAP_STYLE_URL=
LITHONO_MAP_ATTRIBUTION=

# Workshop paid bookings: Stripe TEST keys only; webhook secret required.
# Explicit origin only (no path/query); localhost HTTP or public HTTPS.
LITHONO_APP_ORIGIN=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional development/test Vite cache isolation.
LITHONO_DEMO_CACHE=
