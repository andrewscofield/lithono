{
  "name": "lithono-demo",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:packages": "pnpm --filter lithono build && pnpm --filter create-lithono build",
    "test:package": "node tools/package-gate.mjs",
    "test:tailwind": "LITHONO_TEST_TAILWIND=1 node tools/package-gate.mjs",
    "test:docs": "tsx --test tests/documentation.test.ts",
    "test:docs:checkpoints": "node tools/docs-checkpoints.mjs",
    "test:docs:site": "node tools/docs-site-check.mjs",
    "test:docs:completion": "node tools/docs-completion.mjs",
    "test:browser": "pnpm test:phase2:browser && pnpm test:phase4:browser && pnpm test:phase4:interop && pnpm test:phase5:browser && pnpm test:demos",
    "test:demos": "playwright test --config tests/demo-apps/playwright.config.ts",
    "test:showcase": "tsc --noEmit -p tests/showcase-node/tsconfig.json && tsx --test tests/showcase-node/*.test.ts",
    "test:demos:production": "playwright test --config tests/demo-apps/playwright.production.config.ts",
    "serve": "NODE_ENV=production node dist/server/src/server.js",
    "typecheck": "tsc --noEmit",
    "test:types": "pnpm typecheck && tsc --noEmit -p tests/phase2-browser/tsconfig.json && tsc --noEmit -p tests/phase4-form/tsconfig.json && tsc --noEmit -p tests/phase4-interop/tsconfig.json && tsc --noEmit -p tests/phase5-production/tsconfig.json && tsc --noEmit -p tests/demo-apps/tsconfig.json",
    "test:phase2:browser": "playwright test --config tests/phase2-browser/playwright.config.ts",
    "test:phase4:browser": "playwright test --config tests/phase4-form/playwright.config.ts",
    "test:phase4:interop": "playwright test --config tests/phase4-interop/playwright.config.ts",
    "test:phase4": "tsx --test tests/phase4-input.test.ts",
    "test:node": "tsx --test tests/*.test.ts",
    "test:phase5:browser": "playwright test --config tests/phase5-production/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cli": "tsx ./cli/index.ts",
    "check": "tsx ./cli/index.ts check",
    "manifest": "tsx ./src/framework/editor/manifest.ts",
    "ide:install": "node ./tools/lithono-ide/install.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "animejs": "^4.5.0",
    "better-auth": "^1.7.0",
    "hono": "^4.13.0",
    "lit": "^3.3.0",
    "lithono": "workspace:*",
    "maplibre-gl": "^6.14.0",
    "shiki": "^4.5.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "3.0.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@hono/vite-dev-server": "^0.26.0",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@lit/context": "^1.1.6",
    "@playwright/test": "^1.64.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.18.0",
    "@types/parse5": "^7.0.0",
    "acorn": "^8.18.0",
    "eslint": "^9.10.0",
    "eslint-plugin-lit": "^1.15.0",
    "eslint-plugin-wc": "^3.1.0",
    "magic-string": "^1.4.1",
    "parse5": "^8.0.1",
    "prettier": "^3.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.5.0",
    "typescript-parser": "npm:typescript@~5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  }
}
